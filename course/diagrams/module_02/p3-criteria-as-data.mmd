%%{init: {"theme": "base", "themeVariables": {"fontFamily": "Inter, sans-serif", "primaryColor": "#ECF8F6", "primaryBorderColor": "#40B8A6", "primaryTextColor": "#111827", "lineColor": "#1A3D4D", "secondaryColor": "#F9FAFB", "tertiaryColor": "#FFFFFF", "clusterBkg": "#F9FAFB", "clusterBorder": "#D1D5DB", "actorBkg": "#ECF8F6", "actorBorder": "#40B8A6", "noteBkgColor": "#FFF6DA", "noteBorderColor": "#E0B84C"}}}%%
flowchart TD
  subgraph TEXT["BEFORE: TEAMS, a sentence someone wrote once (Module 1)"]
    t1["travel: flights, hotels, luggage, visas, travel alerts, translation"]
    t2["kitchen_and_dining: recipes, cooking, nutrition, restaurants"]
    t3["8 more teams, a few words each<br/>532 input tokens per call: 29 of 40 teams right"]
  end
  subgraph DATA["AFTER: TEAM_INTENTS, each team's 15 intents from domains.json"]
    d1["travel: plug_type, translate, flight_status, book_flight,<br/>book_hotel, car_rental, ... 15 in all"]
    d2["kitchen_and_dining: recipe, calories, restaurant_reservation,<br/>cancel_reservation, confirm_reservation, ... 15 in all"]
    d3["8 more teams, 15 intents each<br/>1,234 input tokens per call: 39 of 40 teams right"]
  end
  S2["stage 2's options are the SAME lists:<br/>stage 1 sees exactly what stage 2 will offer"]
  t1 ~~~ t2 ~~~ t3
  d1 ~~~ d2 ~~~ d3
  t3 -- "same question, only the criteria change" --> d1
  d3 --> S2

  classDef fail fill:#FDECEA,stroke:#B42318,stroke-width:4px
  classDef changed fill:#D5F2EC,stroke:#1A3D4D,stroke-width:4px
  classDef ok fill:#ECF8F6,stroke:#1A3D4D,stroke-width:3px
  class d2 changed
