%%{init: {"theme": "base", "themeVariables": {"fontFamily": "Inter, sans-serif", "primaryColor": "#ECF8F6", "primaryBorderColor": "#40B8A6", "primaryTextColor": "#111827", "lineColor": "#1A3D4D", "secondaryColor": "#F9FAFB", "tertiaryColor": "#FFFFFF", "clusterBkg": "#F9FAFB", "clusterBorder": "#D1D5DB", "actorBkg": "#ECF8F6", "actorBorder": "#40B8A6", "noteBkgColor": "#FFF6DA", "noteBorderColor": "#E0B84C"}}}%%
flowchart TB
  subgraph CHAT["THE CHAT"]
    direction LR
    T1["customer:<br/>i can't find my card anywhere"]
    T2["customer:<br/>ok so what do i do now"]
    T1 ~~~ T2
  end
  subgraph STATE["STATE: thread, a list of turns"]
    direction LR
    S1["from: customer<br/>i can't find my card anywhere"]
    S2["from: customer<br/>ok so what do i do now"]
    S1 ~~~ S2
  end
  subgraph QUESTIONS["QUESTIONS: 3 Nouls"]
    direction LR
    Q1["lost_or_stolen<br/>names thread"]
    Q2["unknown_charge<br/>names thread"]
    Q3["locked_out<br/>names thread"]
    Q1 ~~~ Q2 ~~~ Q3
  end
  subgraph ANSWERS["JEV ANSWERS"]
    direction LR
    A1["lost_or_stolen 0.77"]
    A2["unknown_charge 0.02"]
    A3["locked_out 0.05"]
    A1 ~~~ A2 ~~~ A3
  end
  subgraph CODE["YOUR CODE: risk_decision(), unchanged"]
    direction LR
    C1[">= 0.7: ESCALATE"]
    C2["> 0.3: REVIEW"]
    C3["else: NONE"]
    C1 ~~~ C2 ~~~ C3
  end
  subgraph OUTCOME["OUTCOME"]
    direction LR
    O1["ESCALATE<br/>reason: lost_or_stolen"]
    O2["6 threads: 3 to 4 ESCALATE<br/>found card REVIEW"]
    O3["stolen wallet 0.66 to 0.71<br/>ESCALATE or REVIEW"]
    O1 ~~~ O2 ~~~ O3
  end
  CHAT --> STATE --> QUESTIONS --> ANSWERS --> CODE --> OUTCOME

  classDef changed fill:#D5F2EC,stroke:#1A3D4D,stroke-width:4px
  classDef score fill:#FFFFFF,stroke:#1A3D4D,stroke-width:2px
  classDef ok fill:#ECF8F6,stroke:#1A3D4D,stroke-width:3px
  classDef border fill:#FFF6DA,stroke:#E0B84C,stroke-width:3px,stroke-dasharray:5 5
  class S1,S2,Q1,Q2,Q3 changed
  class A1,A2,A3 score
  class O1,O2 ok
  class O3 border
