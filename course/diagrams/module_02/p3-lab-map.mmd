%%{init: {"theme": "base", "themeVariables": {"fontFamily": "Inter, sans-serif", "primaryColor": "#ECF8F6", "primaryBorderColor": "#40B8A6", "primaryTextColor": "#111827", "lineColor": "#1A3D4D", "secondaryColor": "#F9FAFB", "tertiaryColor": "#FFFFFF", "clusterBkg": "#F9FAFB", "clusterBorder": "#D1D5DB", "actorBkg": "#ECF8F6", "actorBorder": "#40B8A6", "noteBkgColor": "#FFF6DA", "noteBorderColor": "#E0B84C"}}}%%
flowchart TD
  M["message"]
  subgraph GIVEN["GIVEN: stage 1 from the demo"]
    T["team_question_data<br/>criteria = TEAM_INTENTS"]
  end
  subgraph L1["LAB 3.1 Guided"]
    IQ["intent_question(team)<br/>your intent_instructions,<br/>options: that team's 15 intents"]
    RB["REVIEW_BELOW<br/>your placeholder, 0.5 to 0.9"]
  end
  subgraph L2["LAB 3.2 Core: classify_intent(message)"]
    J1["call 1: team, team_probability"]
    J2["call 2: intent, intent_probability"]
    P["probability = team_probability x intent_probability"]
    G{"probability < REVIEW_BELOW ?"}
    H["needs_review: True<br/>a person checks"]
    AU["needs_review: False<br/>automatic"]
  end
  OUT["returns team, intent, the probabilities,<br/>needs_review, input_tokens"]
  subgraph L3["LAB 3.3 Challenge, optional: nothing later uses it"]
    FL["flat_check(): one Choice over all 150<br/>against the two stages<br/>accuracy, p50 ms, tokens"]
  end
  M --> J1
  T --> J1
  J1 --> J2
  IQ --> J2
  J2 --> P
  P --> G
  RB --> G
  G -- yes --> H
  G -- no --> AU
  H --> OUT
  AU --> OUT
  OUT ~~~ FL
  style L3 stroke-dasharray:5 5

  classDef fail fill:#FDECEA,stroke:#B42318,stroke-width:4px
  classDef changed fill:#D5F2EC,stroke:#1A3D4D,stroke-width:4px
  classDef ok fill:#ECF8F6,stroke:#1A3D4D,stroke-width:3px
  class H ok
  class AU ok
