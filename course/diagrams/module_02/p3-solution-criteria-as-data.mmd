flowchart TD
  subgraph STATE["STATE"]
    S["message: i have to cancel my reservation after all<br/>label: cancel_reservation, owned by kitchen_and_dining"]
  end
  subgraph STAGE1["STAGE 1: a Choice of 10 teams"]
    T["criteria = TEAM_INTENTS, each team's 15 intents<br/>travel: book_hotel, book_flight, car_rental, ...<br/>kitchen_and_dining: ..., cancel_reservation, ..."]
    TA["Jev: kitchen_and_dining 0.97"]
  end
  subgraph STAGE2["STAGE 2: a Choice of the picked team's 15 intents"]
    I["kitchen_and_dining's 15: restaurant_reservation, ...<br/>cancel_reservation IS an option"]
    IA["Jev: cancel_reservation 1.00"]
  end
  subgraph CODE["YOUR CODE"]
    P["probability = 0.97 x 1.00 = 0.97<br/>below REVIEW_BELOW? then a person checks"]
  end
  subgraph OUTCOME["OUTCOME"]
    O["the right intent, no review<br/>40 messages, intent lists: 39 teams right"]
  end
  S --> T --> TA --> I --> IA --> P --> O

  classDef fail fill:#FDECEA,stroke:#B42318,stroke-width:4px
  classDef changed fill:#D5F2EC,stroke:#1A3D4D,stroke-width:4px
  classDef ok fill:#ECF8F6,stroke:#1A3D4D,stroke-width:3px
  class T changed
  class O ok
