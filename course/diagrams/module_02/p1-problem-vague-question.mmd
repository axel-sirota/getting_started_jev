%%{init: {"theme": "base", "themeVariables": {"fontFamily": "Inter, sans-serif", "primaryColor": "#ECF8F6", "primaryBorderColor": "#40B8A6", "primaryTextColor": "#111827", "lineColor": "#1A3D4D", "secondaryColor": "#F9FAFB", "tertiaryColor": "#FFFFFF", "clusterBkg": "#F9FAFB", "clusterBorder": "#D1D5DB", "actorBkg": "#ECF8F6", "actorBorder": "#40B8A6", "noteBkgColor": "#FFF6DA", "noteBorderColor": "#E0B84C"}}}%%
flowchart TB
  subgraph STATE["STATE: 3 of the 10 messages, one call each"]
    direction LR
    S1["cairo<br/>on wednesday, set a notice"]
    S2["oslo<br/>on 11/7, travel notice please"]
    S3["boston<br/>flight tomorrow, on time?"]
    S4["today<br/>Fri, Oct 30"]
    S1 ~~~ S2 ~~~ S3 ~~~ S4
  end
  subgraph QUESTIONS["QUESTIONS: 1 Noul"]
    direction LR
    Q["urgent<br/>notice within 7 days?"]
    H1["hidden: asks for a notice?"]
    H2["hidden: when is the trip?"]
    H3["hidden: within 7 days?"]
    Q ~~~ H1 ~~~ H2 ~~~ H3
  end
  subgraph ANSWERS["JEV ANSWERS: urgent"]
    direction LR
    A1["cairo 0.47"]
    A2["oslo 0.49"]
    A3["boston 0.86"]
    A1 ~~~ A2 ~~~ A3
  end
  subgraph CODE["YOUR CODE"]
    direction LR
    C["URGENT if urgent >= 0.7"]
  end
  subgraph OUTCOME["OUTCOME"]
    direction LR
    O1["cairo: MISS<br/>5 days, asked"]
    O2["oslo: ok by luck<br/>8 days, 0.49"]
    O3["boston: MISS<br/>asked no notice"]
    O4["which judgment failed?<br/>CANNOT TELL"]
    O5["all 10: vague 7 right<br/>careful wording 6"]
    O1 ~~~ O2 ~~~ O3 ~~~ O4 ~~~ O5
  end
  STATE --> QUESTIONS --> ANSWERS --> CODE --> OUTCOME

  classDef fail fill:#FDECEA,stroke:#B42318,stroke-width:4px
  classDef hidden fill:#FFFFFF,stroke:#B42318,stroke-width:2px,stroke-dasharray:5 5
  classDef score fill:#FFFFFF,stroke:#1A3D4D,stroke-width:2px
  class Q fail
  class H1,H2,H3 hidden
  class A1,A2,A3 score
  class O1,O3,O4,O5 fail
