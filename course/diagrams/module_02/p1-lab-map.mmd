%%{init: {"theme": "base", "themeVariables": {"fontFamily": "Inter, sans-serif", "primaryColor": "#ECF8F6", "primaryBorderColor": "#40B8A6", "primaryTextColor": "#111827", "lineColor": "#1A3D4D", "secondaryColor": "#F9FAFB", "tertiaryColor": "#FFFFFF", "clusterBkg": "#F9FAFB", "clusterBorder": "#D1D5DB", "actorBkg": "#ECF8F6", "actorBorder": "#40B8A6", "noteBkgColor": "#FFF6DA", "noteBorderColor": "#E0B84C"}}}%%
flowchart TB
  subgraph ROW1[" "]
    direction LR
    M["message<br/>card stolen, and charges<br/>i don't recognize"]
    subgraph L1["LEVEL 1: 3 literal Nouls"]
      direction TB
      Q1["lost_or_stolen<br/>card lost?"]
      Q2["unknown_charge<br/>charge not mine?"]
      Q3["locked_out<br/>cannot get in?"]
      OR["vs Module 1's 'or' question:<br/>app login: or 0.50<br/>locked_out 0.97"]
      Q1 ~~~ Q2 ~~~ Q3 ~~~ OR
    end
    subgraph L2["LEVEL 2: assess_risk(message)"]
      direction TB
      J["1 Jev call<br/>flags: name to noul"]
      R1["any >= 0.7: ESCALATE<br/>reasons: flags >= 0.7"]
      R2["any > 0.3: REVIEW<br/>reasons: flags 0.3 to 0.7"]
      R3["NONE<br/>reasons: empty"]
      J --> R1 -- no --> R2 -- no --> R3
    end
    subgraph OUT["RETURNS"]
      direction TB
      O1["flags, action, reasons"]
      O2["this message: ESCALATE<br/>2 reasons"]
      O3["8 messages: 4 ESCALATE<br/>1 REVIEW, 3 NONE"]
      O1 ~~~ O2 ~~~ O3
    end
    M --> L1 --> L2 --> OUT
  end
  subgraph L3["LEVEL 3, optional: nothing later uses it"]
    direction LR
    TD["trip_date()<br/>from the demo"]
    W["+ week: Choice<br/>this_week, next_week"]
    TN["trip_date_next()<br/>next friday: Nov 6"]
    TD -.-> W -.-> TN
  end
  ROW1 ~~~ L3

  classDef mine fill:#D5F2EC,stroke:#1A3D4D,stroke-width:4px
  classDef ok fill:#ECF8F6,stroke:#1A3D4D,stroke-width:3px
  classDef opt fill:#FFFFFF,stroke:#40B8A6,stroke-width:2px,stroke-dasharray:5 5
  class Q1,Q2,Q3,J mine
  class R1,R2,R3 ok
  classDef note fill:#FFF6DA,stroke:#E0B84C,stroke-width:2px,stroke-dasharray:5 5
  class OR note
  class TD,W,TN opt
  style L3 stroke-dasharray:5 5
  style ROW1 fill:none,stroke:none
