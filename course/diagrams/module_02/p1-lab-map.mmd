%%{init: {"theme": "base", "themeVariables": {"fontFamily": "Inter, sans-serif", "primaryColor": "#ECF8F6", "primaryBorderColor": "#40B8A6", "primaryTextColor": "#111827", "lineColor": "#1A3D4D", "secondaryColor": "#F9FAFB", "tertiaryColor": "#FFFFFF", "clusterBkg": "#F9FAFB", "clusterBorder": "#D1D5DB", "actorBkg": "#ECF8F6", "actorBorder": "#40B8A6", "noteBkgColor": "#FFF6DA", "noteBorderColor": "#E0B84C"}}}%%
flowchart TD
  M["message, one of 8<br/>my card was stolen and there are charges i don't recognize"]
  subgraph L1["LAB 1.1 Guided: three literal questions, one condition each"]
    Q1["lost_or_stolen<br/>a Noul about message"]
    Q2["unknown_charge<br/>a Noul about message"]
    Q3["locked_out<br/>a Noul about message"]
  end
  subgraph L2["LAB 1.2 Core: assess_risk(message)"]
    J["one jev.system_one call<br/>flags = name: noul"]
    R1{"any flag >= 0.7 ?"}
    R2{"any flag above 0.3 ?"}
    E["ESCALATE<br/>reasons: those flags"]
    V["REVIEW<br/>reasons: those flags"]
    N["NONE<br/>reasons: empty"]
  end
  OUT["returns flags, action, reasons"]
  subgraph L3["LAB 1.3 Challenge, optional: nothing later uses it"]
    W["week: a Choice<br/>this_week / next_week / not_stated"]
    TN["trip_date_next(answers)<br/>next friday: Nov 6, not today"]
  end
  M --> Q1
  M --> Q2
  M --> Q3
  Q1 --> J
  Q2 --> J
  Q3 --> J
  J --> R1
  R1 -- yes --> E
  R1 -- no --> R2
  R2 -- yes --> V
  R2 -- no --> N
  E --> OUT
  V --> OUT
  N --> OUT
  W --> TN
  OUT ~~~ W
  style L3 stroke-dasharray:5 5

  classDef fail fill:#FDECEA,stroke:#B42318,stroke-width:4px
  classDef changed fill:#D5F2EC,stroke:#1A3D4D,stroke-width:4px
  classDef ok fill:#ECF8F6,stroke:#1A3D4D,stroke-width:3px
  class E ok
  class V ok
  class N ok
