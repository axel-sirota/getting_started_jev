%%{init: {"theme": "base", "themeVariables": {"fontFamily": "Inter, sans-serif", "primaryColor": "#ECF8F6", "primaryBorderColor": "#40B8A6", "primaryTextColor": "#111827", "lineColor": "#1A3D4D", "secondaryColor": "#F9FAFB", "tertiaryColor": "#FFFFFF", "clusterBkg": "#F9FAFB", "clusterBorder": "#D1D5DB", "actorBkg": "#ECF8F6", "actorBorder": "#40B8A6", "noteBkgColor": "#FFF6DA", "noteBorderColor": "#E0B84C"}}}%%
flowchart TB
  subgraph STATE["STATE"]
    direction LR
    S1["message<br/>i have to cancel my reservation after all"]
    S2["answer key, not sent to Jev<br/>cancel_reservation<br/>team: kitchen_and_dining"]
    S1 ~~~ S2
  end
  subgraph STAGE1["STAGE 1: a Choice of 10 teams, then JEV ANSWERS"]
    direction LR
    T1["criteria: TEAMS<br/>a few words per team"]
    T2["travel<br/>flights, hotels, ..."]
    T3["JEV: travel 0.95<br/>WRONG TEAM"]
    T1 ~~~ T2 ~~~ T3
  end
  subgraph STAGE2["STAGE 2: a Choice of travel's 15 intents, then JEV ANSWERS"]
    direction LR
    I1["book_hotel, book_flight,<br/>car_rental, ..."]
    I2["cancel_reservation<br/>NOT AN OPTION"]
    I3["JEV: book_hotel 0.67"]
    I1 ~~~ I2 ~~~ I3
  end
  subgraph CODE["YOUR CODE"]
    direction LR
    P["probability = 0.95 x 0.67 = 0.64"]
  end
  subgraph OUTCOME["OUTCOME"]
    direction LR
    O1["intent: book_hotel<br/>WRONG, no error"]
    O2["the right intent was<br/>never an option"]
    O3["teams right, of 40: 29<br/>11 wrong for good"]
    O1 ~~~ O2 ~~~ O3
  end
  STATE --> STAGE1 --> STAGE2 --> CODE --> OUTCOME

  classDef fail fill:#FDECEA,stroke:#B42318,stroke-width:4px
  classDef dropped fill:#FFFFFF,stroke:#B42318,stroke-width:2px,stroke-dasharray:5 5
  classDef score fill:#FFFFFF,stroke:#1A3D4D,stroke-width:2px
  class T1,T3 fail
  class I2 dropped
  class I3 score
  class O1,O2,O3 fail
  classDef key fill:#FFFFFF,stroke:#9CA3AF,stroke-width:2px,stroke-dasharray:5 5
  class S2 key
