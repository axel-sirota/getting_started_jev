%%{init: {"theme": "base", "themeVariables": {"fontFamily": "Inter, sans-serif", "primaryColor": "#ECF8F6", "primaryBorderColor": "#40B8A6", "primaryTextColor": "#111827", "lineColor": "#1A3D4D", "secondaryColor": "#F9FAFB", "tertiaryColor": "#FFFFFF", "clusterBkg": "#F9FAFB", "clusterBorder": "#D1D5DB", "actorBkg": "#ECF8F6", "actorBorder": "#40B8A6", "noteBkgColor": "#FFF6DA", "noteBorderColor": "#E0B84C"}}}%%
flowchart TB
  subgraph ROW1[" "]
    direction LR
    subgraph D1["1. LAST LINE: the problem"]
      direction TB
      S1["STATE<br/>message: last line"]
      Q1["QUESTIONS<br/>about message"]
      A1["lost_or_stolen 0.02<br/>NONE"]
      S1 --> Q1 --> A1
    end
    subgraph D2["2. WHOLE THREAD: the solution"]
      direction TB
      S2["STATE<br/>thread: every turn"]
      Q2["QUESTIONS<br/>name thread"]
      A2["lost_or_stolen 0.77<br/>ESCALATE"]
      S2 --> Q2 --> A2
    end
    D1 ~~~ D2
  end
  subgraph ROW2[" "]
    direction LR
    subgraph D3["3. LAZY FIX: contrast"]
      direction TB
      S3["STATE<br/>earlier_messages + message"]
      Q3["QUESTIONS<br/>about message"]
      A3["lost_or_stolen 0.48<br/>REVIEW"]
      S3 --> Q3 --> A3
    end
    subgraph D4["4. CONTROL: state changed only"]
      direction TB
      S4["STATE<br/>thread: every turn"]
      Q4["QUESTIONS<br/>about message"]
      A4["lost_or_stolen 0.70<br/>at the line: varies by run"]
      S4 --> Q4 --> A4
    end
    D3 ~~~ D4
  end
  ROW1 ~~~ ROW2

  classDef fail fill:#FDECEA,stroke:#B42318,stroke-width:4px
  classDef changed fill:#D5F2EC,stroke:#1A3D4D,stroke-width:4px
  classDef score fill:#FFFFFF,stroke:#1A3D4D,stroke-width:2px
  classDef border fill:#FFF6DA,stroke:#E0B84C,stroke-width:3px,stroke-dasharray:5 5
  class S1,A1 fail
  class S2,Q2 changed
  class A2,A3 score
  class A4 border
  style ROW1 fill:none,stroke:none
  style ROW2 fill:none,stroke:none
