%%{init: {"theme": "base", "themeVariables": {"fontFamily": "Inter, sans-serif", "primaryColor": "#ECF8F6", "primaryBorderColor": "#40B8A6", "primaryTextColor": "#111827", "lineColor": "#1A3D4D", "secondaryColor": "#F9FAFB", "tertiaryColor": "#FFFFFF", "clusterBkg": "#F9FAFB", "clusterBorder": "#D1D5DB", "actorBkg": "#ECF8F6", "actorBorder": "#40B8A6", "noteBkgColor": "#FFF6DA", "noteBorderColor": "#E0B84C"}}}%%
flowchart TB
  subgraph CHAT["THE CHAT"]
    direction LR
    T1["customer:<br/>i can't find my card anywhere"]
    T2["customer:<br/>ok so what do i do now"]
    T1 ~~~ T2
  end
  subgraph STATE["STATE"]
    direction LR
    S2["the lost card line<br/>LEFT OUT"]
    S1["message<br/>ok so what do i do now"]
    S2 ~~~ S1
  end
  subgraph QUESTIONS["QUESTIONS: 3 Nouls"]
    direction LR
    Q1["lost_or_stolen<br/>about message"]
    Q2["unknown_charge<br/>about message"]
    Q3["locked_out<br/>about message"]
    Q1 ~~~ Q2 ~~~ Q3
  end
  subgraph ANSWERS["JEV ANSWERS"]
    direction LR
    A1["lost_or_stolen 0.02"]
    A2["unknown_charge 0.01"]
    A3["locked_out 0.04"]
    A1 ~~~ A2 ~~~ A3
  end
  subgraph CODE["YOUR CODE: risk_decision()"]
    direction LR
    C1[">= 0.7: ESCALATE"]
    C2["> 0.3: REVIEW"]
    C3["else: NONE"]
    C1 ~~~ C2 ~~~ C3
  end
  subgraph OUTCOME["OUTCOME"]
    direction LR
    O1["NONE<br/>lost card MISSED"]
    O2["no error raised"]
    O3["6 threads:<br/>1 ESCALATE"]
    O1 ~~~ O2 ~~~ O3
  end
  CHAT --> STATE --> QUESTIONS --> ANSWERS --> CODE --> OUTCOME

  classDef fail fill:#FDECEA,stroke:#B42318,stroke-width:4px
  classDef score fill:#FFFFFF,stroke:#1A3D4D,stroke-width:2px
  classDef dropped fill:#FFFFFF,stroke:#B42318,stroke-width:2px,stroke-dasharray:5 5
  class S1 fail
  class S2 dropped
  class A1,A2,A3 score
  class O1,O2,O3 fail
