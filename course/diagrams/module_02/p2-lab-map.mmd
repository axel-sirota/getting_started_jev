%%{init: {"theme": "base", "themeVariables": {"fontFamily": "Inter, sans-serif", "primaryColor": "#ECF8F6", "primaryBorderColor": "#40B8A6", "primaryTextColor": "#111827", "lineColor": "#1A3D4D", "secondaryColor": "#F9FAFB", "tertiaryColor": "#FFFFFF", "clusterBkg": "#F9FAFB", "clusterBorder": "#D1D5DB", "actorBkg": "#ECF8F6", "actorBorder": "#40B8A6", "noteBkgColor": "#FFF6DA", "noteBorderColor": "#E0B84C"}}}%%
flowchart TD
  T["TICKET from the support system<br/>ticket_id, customer_id, channel<br/>turns: customer and agent lines, in order"]
  subgraph L1["LAB 2.1 Guided: ticket_state"]
    S["must hold a field called thread: the questions name it<br/>which other fields go in? how does a turn say who spoke?<br/>YOU DECIDE"]
  end
  subgraph GIVEN["GIVEN"]
    Q["THREAD_RISK_QUESTIONS<br/>lost_or_stolen, unknown_charge, locked_out<br/>3 Nouls about thread"]
    D["risk_decision(flags)<br/>ESCALATE / REVIEW / NONE"]
  end
  subgraph L2["LAB 2.2 Core: assess_thread(ticket)"]
    B["build the state from ticket turns,<br/>the way you decided in 2.1"]
    J["one Jev call"]
    F["flags"]
  end
  OUT["returns flags, action, reasons<br/>one row per ticket, 6 tickets"]
  subgraph L3["LAB 2.3 Challenge, optional: nothing later uses it"]
    RQ["+ resolved: a 4th Noul about thread"]
    RR{"resolved >= 0.7 ?<br/>checked first"}
    CL["CLOSE"]
  end
  T --> S
  S --> B
  B --> J
  Q --> J
  J --> F
  F --> D
  D --> OUT
  RQ --> RR
  RR -- yes --> CL
  OUT ~~~ RQ
  style L3 stroke-dasharray:5 5

  classDef fail fill:#FDECEA,stroke:#B42318,stroke-width:4px
  classDef changed fill:#D5F2EC,stroke:#1A3D4D,stroke-width:4px
  classDef ok fill:#ECF8F6,stroke:#1A3D4D,stroke-width:3px
  class S changed
