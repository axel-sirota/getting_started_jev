%%{init: {"theme": "base", "themeVariables": {"fontFamily": "Inter, sans-serif", "primaryColor": "#ECF8F6", "primaryBorderColor": "#40B8A6", "primaryTextColor": "#111827", "lineColor": "#1A3D4D", "secondaryColor": "#F9FAFB", "tertiaryColor": "#FFFFFF", "clusterBkg": "#F9FAFB", "clusterBorder": "#D1D5DB", "actorBkg": "#ECF8F6", "actorBorder": "#40B8A6", "noteBkgColor": "#FFF6DA", "noteBorderColor": "#E0B84C"}}}%%
flowchart TB
  subgraph ROW1[" "]
    direction LR
    subgraph STATE["STATE"]
      S["300 DEV<br/>200 in, 100 out"]
    end
    subgraph QUESTIONS["QUESTIONS"]
      Q["team_question_data<br/>+ fits_question"]
    end
    subgraph ANSWERS["JEV ANSWERS, in code"]
      A["route_score = team x fits<br/>lost card 0.92<br/>carpet 0.05"]
    end
    STATE --> QUESTIONS --> ANSWERS
  end
  subgraph ROW2[" "]
    direction LR
    subgraph CODE["YOUR CODE: target 2%, sweep DEV"]
      direction TB
      G1["0.5: 2.8% wrong<br/>MISSES"]
      G3["0.7: 1.3% wrong<br/>LOWEST PASS"]
      G2["0.9: 0.9% wrong<br/>44 more to a person"]
      G1 ~~~ G3 ~~~ G2
    end
    subgraph OUTCOME["OUTCOME on DEV, then TEST"]
      direction TB
      O1["0.7: 156 routed, 1.3% wrong<br/>144 to a person"]
      O2["TEST once at 0.7<br/>78 of 150 routed, 0 wrong<br/>true rate under 3.8%"]
      R["pinned: jev-1.14.0"]
      O1 ~~~ O2 ~~~ R
    end
    CODE --> OUTCOME
  end
  ROW1 --> ROW2

  classDef fail fill:#FDECEA,stroke:#B42318,stroke-width:4px
  classDef changed fill:#D5F2EC,stroke:#1A3D4D,stroke-width:4px
  classDef ok fill:#ECF8F6,stroke:#1A3D4D,stroke-width:3px
  classDef muted fill:#F3F4F6,stroke:#9CA3AF,stroke-width:2px,color:#6B7280
  classDef human fill:#FFF6DA,stroke:#E0B84C,stroke-width:3px
  style ROW1 fill:none,stroke:none
  style ROW2 fill:none,stroke:none
  class G1 fail
  class G3 changed
  class O1 ok
  class O2 changed
