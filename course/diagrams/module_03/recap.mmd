%%{init: {"theme": "base", "themeVariables": {"fontFamily": "Inter, sans-serif", "primaryColor": "#ECF8F6", "primaryBorderColor": "#40B8A6", "primaryTextColor": "#111827", "lineColor": "#1A3D4D", "secondaryColor": "#F9FAFB", "tertiaryColor": "#FFFFFF", "clusterBkg": "#F9FAFB", "clusterBorder": "#D1D5DB", "actorBkg": "#ECF8F6", "actorBorder": "#40B8A6", "noteBkgColor": "#FFF6DA", "noteBorderColor": "#E0B84C"}}}%%
flowchart TB
  subgraph ROW1[" "]
    direction LR
    subgraph STATE["STATE"]
      S["state = {message: ...}<br/>a dict of facts Jev reads"]
    end
    subgraph QUESTIONS["QUESTIONS, one request"]
      direction TB
      Q1["Choice: which option?"]
      Q2["Score: which level?"]
      Q3["Noul: is it true?"]
      Q4["criteria: a sentence, a list<br/>or data: TEAM_INTENTS"]
      Q1 ~~~ Q2 ~~~ Q3 ~~~ Q4
    end
    subgraph ANSWERS["JEV ANSWERS, typed"]
      direction TB
      A1[".choice, .probabilities<br/>.confidence"]
      A2[".score, .confidence"]
      A3[".noul: probability<br/>the statement is true"]
      A1 ~~~ A2 ~~~ A3
    end
    STATE --> QUESTIONS --> ANSWERS
  end
  subgraph ROW2[" "]
    direction LR
    subgraph CODE["YOUR CODE decides, Modules 1 and 2"]
      direction TB
      C1["Noul bands: below 0.3 no<br/>0.7 or more yes<br/>between: a person looks"]
      C2["REVIEW_BELOW = 0.5<br/>a guess, no data yet"]
      C1 ~~~ C2
    end
    subgraph M3["MODULE 3 measures"]
      direction TB
      M1["is 0.95 right 95 in 100?"]
      M2["a message no team handles?"]
      M4["the review line, from data"]
      M1 ~~~ M2 ~~~ M4
    end
    CODE --> M3
  end
  ROW1 --> ROW2

  classDef changed fill:#D5F2EC,stroke:#1A3D4D,stroke-width:4px
  classDef human fill:#FFF6DA,stroke:#E0B84C,stroke-width:3px
  style ROW1 fill:none,stroke:none
  style ROW2 fill:none,stroke:none
  class C2 human
  class M1 changed
  class M2 changed
  class M4 changed
