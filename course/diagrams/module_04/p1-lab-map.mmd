%%{init: {"theme": "base", "themeVariables": {"fontFamily": "Inter, sans-serif", "primaryColor": "#ECF8F6", "primaryBorderColor": "#40B8A6", "primaryTextColor": "#111827", "lineColor": "#1A3D4D", "secondaryColor": "#F9FAFB", "tertiaryColor": "#FFFFFF", "clusterBkg": "#F9FAFB", "clusterBorder": "#D1D5DB", "actorBkg": "#ECF8F6", "actorBorder": "#40B8A6", "noteBkgColor": "#FFF6DA", "noteBorderColor": "#E0B84C"}}}%%
flowchart LR
  L1["LAB 1.1 Guided<br/>3 decisions: fits_instructions,<br/>REVIEW_BELOW, MIDDLE_BAND"]
  subgraph L2["LAB 1.2 Core: route(message)"]
    direction TB
    J["one request: intent + fits"]
    subgraph RU["the rules, in no order"]
      direction LR
      R1["fits<br/>below 0.3"]
      R2["fits 0.3 to 0.7<br/>MIDDLE_BAND"]
      R3["p below<br/>REVIEW_BELOW"]
      R4["a HUMAN<br/>intent"]
      R5["the<br/>table"]
    end
    O["first match wins<br/>ORDER: your decision"]
    T["test: ebola, a PIN request<br/>where should each go?"]
    J --> RU --> O --> T
  end
  L3["LAB 1.3, optional<br/>route_report():<br/>120 labeled"]
  L1 --> L2
  L2 -.-> L3
  style L3 stroke-dasharray:5 5

  classDef fail fill:#FDECEA,stroke:#B42318,stroke-width:4px
  classDef changed fill:#D5F2EC,stroke:#1A3D4D,stroke-width:4px
  classDef ok fill:#ECF8F6,stroke:#1A3D4D,stroke-width:3px
  classDef human fill:#FFF6DA,stroke:#B7791F,stroke-width:4px
  classDef jev fill:#D5F2EC,stroke:#40B8A6,stroke-width:3px
  classDef code fill:#FFFFFF,stroke:#1A3D4D,stroke-width:3px
  classDef llm fill:#EEF2FF,stroke:#4B5563,stroke-width:3px
  class L1,O changed
  class J jev
  class R1,R2,R3,R4,R5 code
  class T human
