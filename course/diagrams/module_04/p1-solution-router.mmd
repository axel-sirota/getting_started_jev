    M2["lost my card, freeze it"]
    M3["how do i make lasagna"]
    M4["how do i get rid<br/>of a sore throat"]
  end
  subgraph JEV["JEV: intent"]
    J1["balance 1.00"]
    J2["report_lost_card<br/>0.68"]
    J3["recipe 1.00"]
    J4["what_can_i_ask_you<br/>0.21"]
  end
  subgraph CODE["CODE: the table"]
    C1["CODE"]
    C2["HUMAN<br/>always a person"]
    C3["LLM"]
    C4["LLM"]
  end
  subgraph GETS["THE CUSTOMER GETS"]
    O1["Checking $1,284.50<br/>no LLM call, $0"]
